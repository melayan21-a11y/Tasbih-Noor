<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_emerald"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Title, Shuffle Reminder Button & Streak Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🕌 Tasbih Noor"
            android:textColor="#E6C875"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_shuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="↻ Next Dua"
            android:textColor="#F3E5AB"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_pill"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="🔥 1d"
            android:textColor="#F3E5AB"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Spiritual Athkar / Dua / Reminder Card -->
    <LinearLayout
        android:id="@+id/widget_reminder_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_widget_reminder_card"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_reminder_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Daily Athkar"
            android:textColor="#E5C158"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_reminder_arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="right"
            android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ"
            android:textColor="#FFFDF0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_reminder_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SubhanAllahi wa bihamdihi • Glory be to Allah &amp; His praise"
            android:textColor="#C8E6C9"
            android:textSize="10sp"
            android:maxLines="2" />
    </LinearLayout>

    <!-- Bottom Counter & Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Dhikr Title & Count -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_dhikr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SubhanAllah"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today: "
                    android:textColor="#A5D6A7"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="33"
                    android:textColor="#F5D061"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- +1 Bead Tap Button -->
        <Button
            android:id="@+id/widget_btn_tap"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_widget_btn_gold"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="+1 Bead"
            android:textColor="#071914"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Open App Button -->
        <Button
            android:id="@+id/widget_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_pill"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Open ➔"
            android:textColor="#F3E5AB"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
