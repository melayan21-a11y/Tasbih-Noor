<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_emerald"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Title, Shuffle Reminder Button & Streak Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🕌 Tasbih Noor"
            android:textColor="#F6DE8F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_shuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="↻ Next Dua"
            android:textColor="#FFF2C2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_pill"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="🔥 1d"
            android:textColor="#FFF2C2"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Visual Spiritual Remembrance & Reminder Card -->
    <LinearLayout
        android:id="@+id/widget_reminder_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_widget_reminder_card"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_reminder_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Daily Athkar"
            android:textColor="#F4CE62"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- High-Legibility Arabic Script -->
        <TextView
            android:id="@+id/widget_reminder_arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="right"
            android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:lineSpacingExtra="5dp"
            android:maxLines="3" />

        <!-- Clear, Prominent Translation & Meaning -->
        <TextView
            android:id="@+id/widget_reminder_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SubhanAllahi wa bihamdihi • Glory be to Allah and His praise"
            android:textColor="#D6EFE0"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:maxLines="3" />
    </LinearLayout>

    <!-- Clean Footer Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_hint_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap card or ↻ for next reminder"
            android:textColor="#A3C6B9"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Open Noor ➔"
            android:textColor="#F3E5AB"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
